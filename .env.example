# Smart Parking Management System Configuration

# Application Security
SECRET_KEY=smart_parking_secret_key_change_in_production_89412
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database Configuration (MySQL 8.0)
# Change user, password, host, port, and database name as per your local installation
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smart_parking_db

# When True, if MySQL is unreachable or credentials fail, the system automatically 
# falls back to a local SQLite database (smart_parking_local.db) for zero-friction local testing.
ENABLE_SQLITE_FALLBACK=True

# Payment Gateway Configuration
PAYMENT_SANDBOX_MODE=True
MOCK_UPI_MERCHANT_ID=smartpark@bank
MOCK_GATEWAY_KEY=sandbox_key_smart_parking_mock

# Smart Parking Business Rules
RESERVATION_EXPIRY_MINUTES=10
DEFAULT_BASE_HOURS=4
DEFAULT_BASE_RATE=50.00
DEFAULT_HOURLY_RATE=20.00
GRACE_PERIOD_MINUTES=15

# Hardware Barrier Simulation
BARRIER_AUTO_CLOSE_SECONDS=6
BARRIER_HARDWARE_WEBHOOK_URL=http://localhost:5000/api/v1/hardware/barrier/ack
